menu "ESP32-S3 Touch LCD 3.5 BSP"
    config BSP_LCD_POWERON_RESTART
        bool "Preserve original LCD cold-start software restart"
        default y
        help
            Restart once after creating LCD SPI IO on a power-on reset,
            as in the original 260911 factory firmware.
    config BSP_LCD_SPI_CLOCK_HZ
        int "LCD SPI clock (Hz)"
        range 10000000 80000000
        default 80000000
    config BSP_LCD_BUFFER_HEIGHT
        int "LVGL DMA draw buffer height"
        range 10 80
        default 10
    config BSP_LCD_BRIGHTNESS
        int "Initial backlight percentage"
        range 0 100
        default 80
endmenu
